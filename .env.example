NODE_ENV=development
PORT=3001

# ─── Database (NeonDB) ──────────────────────────────────────────────
# Elex DB lives in its own NeonDB project, separate from TradeX.
ELEX_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST.neon.tech/elex_dev?sslmode=require

# ─── JWT ────────────────────────────────────────────────────────────
# Single secret — admins and traders share the users table; role is in
# the JWT payload. Distinct from TradeX's JWT_SECRET.
ELEX_JWT_SECRET=change_this_to_a_long_random_string
ELEX_JWT_EXPIRATION=86400

# ─── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. *.vercel.app is also allowed
# automatically via the bootstrap.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# ─── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Twilio (WhatsApp OTP) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_OTP_CONTENT_SID=your_twilio_otp_content_sid

# ─── SendGrid (Email) ───────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM=
